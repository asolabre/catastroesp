   <property name="toolTip">
    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Entrar un texto que reuna una lista de Referencias catastrales, separadas por coma &lt;span style=&quot; font-weight:600;&quot;&gt;',&lt;/span&gt;', punto y coma &lt;span style=&quot; font-weight:600;&quot;&gt;';'&lt;/span&gt;, punto &lt;span style=&quot; font-weight:600;&quot;&gt;'.'&lt;/span&gt;, barra de separador &lt;span style=&quot; font-weight:600;&quot;&gt;'\'&lt;/span&gt;.&lt;br/&gt;&lt;br/&gt;Los espacios se eliminarán de forma automatica.&lt;/p&gt;&lt;p&gt;Puede tratarse de RRCC de 14 o de 20 caracteres.&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;EJEMPLO: &lt;/span&gt;'02056A0 0900526xxxx, 02056A00900 604aaaa, 020 56A00900267; 02056A009002 69: 02056A009006 25. 02056A00 90026, 02056A00909002, 02056A00909031'&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
   </property>
